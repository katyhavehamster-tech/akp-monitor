# Перелік змінних оточення АКП-Монітор (скопіюйте у .env та вкажіть власні значення)
DJANGO_SECRET_KEY=
DJANGO_DEBUG=
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_ORIGINS=
DJANGO_CORS_ORIGINS=
DJANGO_SECURE_SSL=
AKP_DEMO_MODE=

# Параметри PostgreSQL (якщо не задано POSTGRES_DB — використовується локальний SQLite)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=
