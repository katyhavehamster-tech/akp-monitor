akpmonitor.dev {
    # Жорстке обмеження розміру тіла запиту на рівні вебсервера (20 МБ)
    request_body {
        max_size 20MB
    }

    # Блокування зовнішнього доступу до панелі Django-admin
    respond /django-admin* "Доступ заборонено (використовуйте авторизацію за електронним ключем .key)" 403

    # Reverse proxy до Django/Gunicorn
    reverse_proxy localhost:8000 {
        header_down -Strict-Transport-Security
        header_down -Server
        header_down -X-Powered-By
    }

    # OWASP: HSTS з preload (єдине канонічне джерело)
    header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # Резервний Air-Gapped CSP для автономного контуру без зовнішніх CDN
    header ?Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"

    # Приховання технологічного стеку
    header -Server
    header -X-Powered-By
    header -Via
}
